# ==============================================================================
# MITRA Backend Environment Variables
# ==============================================================================

# Application Settings
APP_NAME=MITRA
APP_VERSION=0.1.0
APP_ENV=production
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Simulation / Digital-Twin Principle (Always true for demo/prototype)
SIMULATION_MODE=true

# AI Provider Configuration
# AI_PROVIDER_PREFERENCE: 'auto' | 'gemini' | 'huggingface' | 'fallback'
AI_PROVIDER_PREFERENCE=auto
ENABLE_LLM=true

# Google Gemini API Key (Get from https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Hugging Face API Key (Optional fallback)
HF_API_KEY=
HF_MODEL=meta-llama/Llama-3.2-3B-Instruct

# CORS Configuration (Comma-separated list or * for all)
CORS_ORIGINS=*
